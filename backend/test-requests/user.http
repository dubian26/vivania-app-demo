### Variables
@baseUrl = http://localhost:3000
@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..rBW-134ZFoQ8pWO4ilk4SpxJFqQzLl6Gx6wGLxDEXiw
@refreshToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..P4iC4tqC7XJ1xmvLhxM0av17yZM7Vj1bASKENysyS2E

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
   "email": "root@admin.com",
   "password": "Admin*123"
}

### Refrescar Token
POST {{baseUrl}}/auth/refrescar-token
Content-Type: application/json
Cookie: refreshToken={{refreshToken}}

### Crear Cuenta Usuario
POST {{baseUrl}}/auth/crear-cuenta
Content-Type: application/json

{
   "email": "test@example.com",
   "password": "password123",
   "nombres": "Juan",
   "apellidos": "Perez"
}

### Listar Usuarios
GET {{baseUrl}}/usuarios
Cookie: accessToken={{accessToken}}
Cookie: refreshToken={{refreshToken}}

### Buscar Usuario por Id
GET {{baseUrl}}/usuarios/019cef77ac8677efb5f02cbe529f3374
Cookie: accessToken={{accessToken}}
Cookie: refreshToken={{refreshToken}}

### Buscar Usuario por Email
GET {{baseUrl}}/usuarios/email/dubian26@gmail.com
Cookie: accessToken={{accessToken}}
Cookie: refreshToken={{refreshToken}}

### Actualizar Usuario
PUT {{baseUrl}}/usuarios/019cef77ac8677efb5f02cbe529f3374
Content-Type: application/json
Cookie: accessToken={{accessToken}}
Cookie: refreshToken={{refreshToken}}

{
   "nombres": "Juan Actualizado",
   "apellidos": "Perez Actualizado"
}

### Inactivar Usuario
PUT {{baseUrl}}/usuarios/019cef77ac8677efb5f02cbe529f3374/inactivar
Cookie: accessToken={{accessToken}}
Cookie: refreshToken={{refreshToken}}

### Eliminar Usuario
DELETE {{baseUrl}}/usuarios/019cf83a7882728eafebd0b9e839a675
Cookie: accessToken={{accessToken}}
Cookie: refreshToken={{refreshToken}}
