{
   "$schema": "https://opencode.ai/config.json",
   "plugin": [
      "opencode-gemini-auth@latest"
   ],
   "mcp": {
      "context7": {
         "type": "local",
         "enabled": true,
         "command": [
            "npx",
            "-y",
            "@upstash/context7-mcp",
            "--api-key",
            "$CONTEXT7_API_KEY"
         ]
      },
      "shadcn": {
         "type": "local",
         "enabled": false,
         "command": [
            "npx",
            "shadcn@latest",
            "mcp"
         ]
      }
   },
   "watcher": {
      "ignore": [
         "node_modules/**",
         "dist/**",
         ".git/**",
         "bin/**",
         "obj/**",
         "*.log",
         "*.svg",
         "package-lock.json",
         "**/.*"
      ]
   },
   "small_model": "github-copilot/gpt-5-mini",
   "default_agent": "plan",
   "agent": {
      "plan": {
         "model": "github-copilot/gpt-5.4",
         "variant": "high"
      },
      "build": {
         "model": "github-copilot/gpt-5.4",
         "variant": "medium",
         "permissions": {
            "bash": "ask",
            "file_edits": "ask"
         }
      }
   }
}