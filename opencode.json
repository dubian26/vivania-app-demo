{
   "$schema": "https://opencode.ai/config.json",
   "agent": {
      "plan": {
         "permission": {
            "external_directory": "allow",
            "read": {
               "*.env": "allow",
               "*.env.*": "allow"
            }
         }
      },
      "build": {
         "permission": {
            "external_directory": "allow",
            "read": {
               "*.env": "allow",
               "*.env.*": "allow"
            }
         }
      }
   },
   "mcp": {
      "context7": {
         "type": "local",
         "enabled": true,
         "command": [
            "npx",
            "-y",
            "@upstash/context7-mcp",
            "--api-key",
            "$CONTEXT7_API_KEY"
         ]
      },
      "shadcn": {
         "type": "local",
         "enabled": false,
         "command": [
            "npx",
            "shadcn@latest",
            "mcp"
         ]
      }
   },
   "watcher": {
      "ignore": [
         "node_modules/**",
         "dist/**",
         ".git/**",
         "bin/**",
         "obj/**",
         "*.log",
         "*.svg",
         "package-lock.json",
         "**/.*"
      ]
   },
   "autoApprove": {
      "read": "allow",
      "search": "allow"
   }
}