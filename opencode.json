{
   "$schema": "https://opencode.ai/config.json",
   "mcp": {
      "context7": {
         "type": "local",
         "enabled": true,
         "command": [
            "npx",
            "-y",
            "@upstash/context7-mcp",
            "--api-key",
            "$CONTEXT7_API_KEY"
         ]
      },
      "shadcn": {
         "type": "local",
         "enabled": false,
         "command": [
            "npx",
            "shadcn@latest",
            "mcp"
         ]
      }
   },
   "watcher": {
      "ignore": [
         "node_modules/**",
         "dist/**",
         ".git/**",
         "bin/**",
         "obj/**",
         "*.log",
         "*.svg",
         "package-lock.json",
         "**/.*"
      ]
   },
   "permissions": {
      "read": "allow",
      "list_dir": "allow",
      "external_paths": "allow"
   },
   "autoApprove": {
      "read": true,
      "search": true
   }
}